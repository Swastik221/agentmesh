# AgentMesh environment. Copy to .env for local development.
# Never commit real secrets. Staging/production values go in your host's
# secret store, not in a file (see docs/DEPLOYMENT.md).
#
#   Local dev:   the values below work as-is with a local PostgreSQL.
#   Tests:       nothing extra; see TEST_DATABASE_URL below.
#   Staging/prod: NODE_ENV=production, https WEB_ORIGIN, SIWE_DOMAIN/SIWE_URI,
#                TRUST_PROXY behind a load balancer, and the web build needs
#                VITE_API_URL/VITE_WS_URL pointing at the public server.

# Server network
PORT=3001
# The web app's origin. CORS, the WebSocket Origin check and the SIWE domain
# derive from it. Must be https:// when NODE_ENV=production.
WEB_ORIGIN=http://localhost:5173
# NODE_ENV=production
# Behind a load balancer / reverse proxy, how many hops to trust ("1" for one),
# so rate limits see the real client IP and Secure cookies work.
# TRUST_PROXY=1
# Per-IP requests per minute (defaults shown).
# RATE_LIMIT_NONCE_PER_MIN=60
# RATE_LIMIT_VERIFY_PER_MIN=30
# RATE_LIMIT_TOKENS_PER_MIN=20
# RATE_LIMIT_JOIN_PER_MIN=20

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentmesh?schema=public"

# Server test database. The server tests delete every row in the tables they
# touch, so they never use DATABASE_URL directly: they run against
# TEST_DATABASE_URL, or, when it is unset, DATABASE_URL's database name with
# "_test" appended (agentmesh_test here). Migrations are applied, and the
# database created, automatically before each run. The run refuses to start
# if the database name does not end in "_test".
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentmesh_test?schema=public"

# Absolute base directory for provisioned project workspaces and their git repos
# WORKSPACE_ROOT=/absolute/path/to/workspaces

# SIWE (Sign-In With Ethereum) Authentication Configuration
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:5173
SIWE_CHAIN_ID=11155111

# ENS (Ethereum Name Service) Configuration
# ENS is read from mainnet by default, which is the real registry.
# To exercise ENS on the testnet the rest of the product uses, point both of
# these at Sepolia and register a name at https://sepolia.app.ens.domains:
#   ENS_CHAIN_ID=11155111
#   ENS_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_CHAIN_ID=1
ENS_RPC_URL=https://ethereum-rpc.publicnode.com
ENS_TIMEOUT_MS=8000

# Hedera x402 payments (testnet only; the server refuses any other network).
# The receiver is the account paid; it needs no key here. The fee payer is
# whatever account the facilitator advertises at its /supported endpoint.
HEDERA_NETWORK=hedera:testnet
HEDERA_PAYMENT_RECEIVER=0.0.9185802
X402_FACILITATOR_URL=https://x402.org/facilitator

# Web app (Vite, read at build time). A deployment build refuses to run
# without them when AGENTMESH_REQUIRE_API_URL=true or on Vercel production.
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
# AGENTMESH_REQUIRE_API_URL=true

# CLI (`agentmesh connect | terminal | context | mcp`): flags or these.
# AGENTMESH_URL=http://localhost:3001
# AGENTMESH_WORKSPACE=<project id>
# AGENTMESH_AGENT=<agent id>
# AGENTMESH_CONNECT_TOKEN=<token from the workspace UI>
