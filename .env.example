# AgentMesh Production & Development Environment Configuration
# NOTE: Never commit secret keys or private keys to source control.

# Server Network Configuration
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agentmesh?schema=public"

# SIWE (Sign-In With Ethereum) Authentication Configuration
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:5173
SIWE_CHAIN_ID=11155111

# ENS (Ethereum Name Service) Configuration
ENS_RPC_URL=https://eth.llamarpc.com
ENS_TIMEOUT_MS=8000

# Hedera x402 Payment Architecture Configuration
HEDERA_NETWORK=hedera:testnet
HEDERA_PAYMENT_RECEIVER=0.0.9185802
X402_FACILITATOR_URL=https://x402.org/facilitator

# Frontend Endpoints (Vite Environment Variables)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
