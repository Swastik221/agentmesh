datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum AgentStatus {
  OFFLINE
  ONLINE
  BUSY
}

model User {
  id            String              @id @default(cuid())
  walletAddress String?             @unique
  displayName   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  ownedProjects Project[]           @relation("UserOwnedProjects")
  memberships   ProjectMember[]     @relation("UserProjectMemberships")
  ownedAgents   Agent[]             @relation("UserOwnedAgents")
  authSessions  AuthSession[]
  brainEntries  ProjectBrainEntry[]
  createdTasks  Task[]
  artifacts     Artifact[]

  @@map("users")
}


model Project {
  id           String              @id @default(cuid())
  name         String
  description  String?
  ownerId      String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  owner        User                @relation("UserOwnedProjects", fields: [ownerId], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  agents       Agent[]
  brainEntries ProjectBrainEntry[]
  tasks        Task[]
  workspace    ProjectWorkspace?
  artifacts    Artifact[]
  taskDependencies TaskDependency[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())

  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation("UserProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Agent {
  id        String      @id @default(cuid())
  projectId String
  ownerId   String
  name      String
  provider  String
  status    AgentStatus @default(OFFLINE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner                User                 @relation("UserOwnedAgents", fields: [ownerId], references: [id], onDelete: Restrict)
  capabilities         AgentCapability[]
  taskResponsibilities TaskResponsibility[]
  executions           TaskExecution[]
  worktrees            GitWorktree[]
  preferredTasks       Task[]               @relation("PreferredAgentTasks")
  artifacts            Artifact[]

  @@index([projectId])
  @@index([ownerId])
  @@index([status])
  @@map("agents")
}

model AgentCapability {
  id         String   @id @default(cuid())
  agentId    String
  capability String
  createdAt  DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, capability])
  @@index([agentId])
  @@index([capability])
  @@map("agent_capabilities")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model SiweNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("siwe_nonces")
}

enum ProjectBrainEntryType {
  REQUIREMENT
  DECISION
  NOTE
  CONSTRAINT
}

model ProjectBrainEntry {
  id        String                @id @default(cuid())
  projectId String
  authorId  String
  type      ProjectBrainEntryType
  title     String
  content   String
  metadata  Json?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([projectId, type])
  @@index([authorId])
  @@map("project_brain_entries")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id                   String       @id @default(cuid())
  projectId            String
  creatorId            String
  preferredAgentId     String?
  title                String
  description          String
  status               TaskStatus   @default(TODO)
  priority             TaskPriority @default(MEDIUM)
  filePaths            String[]     @default([])
  requiredCapabilities String[]     @default([])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator          User                 @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  preferredAgent   Agent?               @relation("PreferredAgentTasks", fields: [preferredAgentId], references: [id], onDelete: SetNull)
  responsibilities TaskResponsibility[]
  dependencies     TaskDependency[]     @relation("TaskDependencies")
  dependents       TaskDependency[]     @relation("TaskDependents")
  executions       TaskExecution[]
  worktrees        GitWorktree[]
  artifacts        Artifact[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([creatorId])
  @@index([preferredAgentId])
  @@map("tasks")
}

model TaskResponsibility {
  id                    String   @id @default(cuid())
  taskId                String
  agentId               String
  role                  String?
  assignmentSource      String?
  assignmentExplanation Json?
  createdAt             DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([taskId, agentId])
  @@index([taskId])
  @@index([agentId])
  @@map("task_responsibilities")
}

model TaskDependency {
  id              String   @id @default(cuid())
  projectId       String
  taskId          String
  dependsOnTaskId String?
  artifactId      String?
  dependencyType  String   @default("TASK_COMPLETION")
  createdAt       DateTime @default(now())

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task      @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task?     @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  artifact      Artifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@unique([taskId, artifactId])
  @@index([projectId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@index([artifactId])
  @@map("task_dependencies")
}

model Artifact {
  id          String   @id @default(cuid())
  projectId   String
  taskId      String
  executionId String?
  agentId     String
  ownerUserId String

  type        String
  name        String
  version     Int      @default(1)
  payload     Json

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  execution    TaskExecution?   @relation(fields: [executionId], references: [id], onDelete: SetNull)
  agent        Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ownerUser    User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  dependencies TaskDependency[]

  @@unique([taskId, name, version])
  @@index([projectId])
  @@index([taskId])
  @@index([agentId])
  @@index([executionId])
  @@index([ownerUserId])
  @@map("artifacts")
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model TaskExecution {
  id          String          @id @default(cuid())
  taskId      String
  agentId     String
  status      ExecutionStatus @default(QUEUED)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  task     Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent    Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  worktree GitWorktree?
  artifacts Artifact[]

  @@index([taskId])
  @@index([agentId])
  @@index([status])
  @@map("task_executions")
}

model ProjectWorkspace {
  id          String   @id @default(cuid())
  projectId   String   @unique
  rootPath    String
  gitRepoPath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worktrees GitWorktree[]

  @@map("project_workspaces")
}

enum GitWorktreeStatus {
  ACTIVE
  REMOVED
}

model GitWorktree {
  id          String            @id @default(cuid())
  workspaceId String
  executionId String            @unique
  agentId     String
  taskId      String
  path        String
  branchName  String
  status      GitWorktreeStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace ProjectWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution TaskExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  agent     Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([agentId])
  @@index([taskId])
  @@index([status])
  @@map("git_worktrees")
}
