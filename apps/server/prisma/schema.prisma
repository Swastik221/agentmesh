datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum AgentStatus {
  OFFLINE
  ONLINE
  BUSY
}

model User {
  id            String    @id @default(cuid())
  walletAddress String?   @unique
  displayName   String?
  /// Primary ENS name for walletAddress, cached after a verified round trip
  /// (reverse record confirmed by forward resolution). Null means the wallet
  /// has no primary name, or the last lookup could not confirm one.
  ensName       String?
  /// When ensName was last refreshed from the chain. Used to avoid an RPC call
  /// on every sign-in; null means it has never been looked up.
  ensCheckedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedProjects             Project[]           @relation("UserOwnedProjects")
  memberships               ProjectMember[]     @relation("UserProjectMemberships")
  ownedAgents               Agent[]             @relation("UserOwnedAgents")
  authSessions              AuthSession[]
  brainEntries              ProjectBrainEntry[]
  createdTasks              Task[]
  artifacts                 Artifact[]
  artifactsReviewed         Artifact[]          @relation("ArtifactReviewer")
  approvalRequestsRequested ApprovalRequest[]   @relation("ApprovalRequester")
  approvalRequestsResolved  ApprovalRequest[]   @relation("ApprovalResolver")
  payments                  Payment[]           @relation("PaymentRequester")
  agentConnectTokens        AgentConnectToken[] @relation("AgentConnectTokenIssuer")
  terminalSessions          TerminalSession[]   @relation("TerminalSessionOwner")
  invitationsSent           ProjectInvitation[] @relation("InvitationInviter")

  @@map("users")
}

model Project {
  id           String   @id @default(cuid())
  name         String
  description  String?
  ownerId      String
  /// Shareable code the owner hands out so a teammate can join this exact
  /// workspace. Nullable because it is minted on first use rather than
  /// backfilled, and unique so a code can only ever resolve to one project.
  joinCode     String?  @unique
  lastSequence Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner              User                @relation("UserOwnedProjects", fields: [ownerId], references: [id], onDelete: Restrict)
  members            ProjectMember[]
  agents             Agent[]
  brainEntries       ProjectBrainEntry[]
  tasks              Task[]
  workspace          ProjectWorkspace?
  artifacts          Artifact[]
  taskDependencies   TaskDependency[]
  activityEvents     ActivityEvent[]
  policies           Policy[]
  approvalRequests   ApprovalRequest[]
  payments           Payment[]
  invitations        ProjectInvitation[]
  agentConnectTokens AgentConnectToken[]
  terminalSessions   TerminalSession[]

  @@index([ownerId])
  @@map("projects")
}

model ProjectInvitation {
  id            String           @id @default(cuid())
  projectId     String
  inviterUserId String
  invitedWallet String
  role          ProjectRole      @default(MEMBER)
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviterUser User    @relation("InvitationInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, invitedWallet, status])
  @@index([projectId])
  @@index([invitedWallet])
  @@index([status])
  @@map("project_invitations")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("UserProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Agent {
  id        String      @id @default(cuid())
  projectId String
  ownerId   String
  name      String
  provider  String
  status    AgentStatus @default(OFFLINE)

  ensName       String?
  ensAddress    String?
  ensVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner                User                 @relation("UserOwnedAgents", fields: [ownerId], references: [id], onDelete: Restrict)
  capabilities         AgentCapability[]
  taskResponsibilities TaskResponsibility[]
  executions           TaskExecution[]
  worktrees            GitWorktree[]
  preferredTasks       Task[]               @relation("PreferredAgentTasks")
  artifacts            Artifact[]
  approvalRequests     ApprovalRequest[]
  payments             Payment[]
  connectTokens        AgentConnectToken[]
  terminalSessions     TerminalSession[]

  @@index([projectId])
  @@index([ownerId])
  @@index([status])
  @@map("agents")
}

model AgentCapability {
  id         String   @id @default(cuid())
  agentId    String
  capability String
  createdAt  DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, capability])
  @@index([agentId])
  @@index([capability])
  @@map("agent_capabilities")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model SiweNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("siwe_nonces")
}

enum ProjectBrainEntryType {
  REQUIREMENT
  DECISION
  NOTE
  CONSTRAINT
}

model ProjectBrainEntry {
  id        String                @id @default(cuid())
  projectId String
  authorId  String
  type      ProjectBrainEntryType
  title     String
  content   String
  metadata  Json?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([projectId, type])
  @@index([authorId])
  @@map("project_brain_entries")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_APPROVAL
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id                   String       @id @default(cuid())
  projectId            String
  creatorId            String
  preferredAgentId     String?
  title                String
  description          String
  status               TaskStatus   @default(TODO)
  priority             TaskPriority @default(MEDIUM)
  filePaths            String[]     @default([])
  requiredCapabilities String[]     @default([])
  /// Set when the task was posted to the shared board as an open offer that
  /// any agent in the project may claim. Until this moment passes the task is
  /// on the board unassigned; after it, the coordinator assigns it to a free
  /// agent. Cleared once the task has an owner, so a claimed task is never
  /// swept again.
  offerExpiresAt       DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator          User                 @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  preferredAgent   Agent?               @relation("PreferredAgentTasks", fields: [preferredAgentId], references: [id], onDelete: SetNull)
  responsibilities TaskResponsibility[]
  dependencies     TaskDependency[]     @relation("TaskDependencies")
  dependents       TaskDependency[]     @relation("TaskDependents")
  executions       TaskExecution[]
  worktrees        GitWorktree[]
  artifacts        Artifact[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([creatorId])
  @@index([preferredAgentId])
  /// The sweeper polls for offers that are due, so this is the index it rides.
  @@index([offerExpiresAt])
  @@map("tasks")
}

model TaskResponsibility {
  id                    String   @id @default(cuid())
  taskId                String
  agentId               String
  role                  String?
  assignmentSource      String?
  assignmentExplanation Json?
  createdAt             DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([taskId, agentId])
  @@index([taskId])
  @@index([agentId])
  @@map("task_responsibilities")
}

model TaskDependency {
  id              String   @id @default(cuid())
  projectId       String
  taskId          String
  dependsOnTaskId String?
  artifactId      String?
  dependencyType  String   @default("TASK_COMPLETION")
  createdAt       DateTime @default(now())

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task      @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task?     @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  artifact      Artifact? @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@unique([taskId, artifactId])
  @@index([projectId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@index([artifactId])
  @@map("task_dependencies")
}

enum ArtifactStatus {
  PENDING
  APPROVED
  REJECTED
}

model Artifact {
  id          String  @id @default(cuid())
  projectId   String
  taskId      String
  executionId String?
  agentId     String
  ownerUserId String

  type           String
  name           String
  version        Int            @default(1)
  payload        Json
  status         ArtifactStatus @default(PENDING)
  requiresReview Boolean        @default(false)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  execution    TaskExecution?   @relation(fields: [executionId], references: [id], onDelete: SetNull)
  agent        Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ownerUser    User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  reviewedBy   User?            @relation("ArtifactReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  dependencies TaskDependency[]

  @@unique([taskId, name, version])
  @@index([projectId])
  @@index([taskId])
  @@index([agentId])
  @@index([executionId])
  @@index([ownerUserId])
  @@map("artifacts")
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model TaskExecution {
  id          String          @id @default(cuid())
  taskId      String
  agentId     String
  status      ExecutionStatus @default(QUEUED)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  worktree  GitWorktree?
  artifacts Artifact[]

  @@index([taskId])
  @@index([agentId])
  @@index([status])
  @@map("task_executions")
}

model ProjectWorkspace {
  id          String   @id @default(cuid())
  projectId   String   @unique
  rootPath    String
  gitRepoPath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worktrees GitWorktree[]

  @@map("project_workspaces")
}

model ActivityEvent {
  id         String   @id @default(cuid())
  projectId  String
  type       String
  actorType  String
  actorId    String
  actorName  String?
  taskId     String?
  artifactId String?
  payload    Json?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("activity_events")
}

enum GitWorktreeStatus {
  ACTIVE
  REMOVED
}

model GitWorktree {
  id          String            @id @default(cuid())
  workspaceId String
  executionId String            @unique
  agentId     String
  taskId      String
  path        String
  branchName  String
  status      GitWorktreeStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace ProjectWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution TaskExecution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  agent     Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([agentId])
  @@index([taskId])
  @@index([status])
  @@map("git_worktrees")
}

enum PolicyDecision {
  ALLOW
  APPROVAL_REQUIRED
  DENY
}

model Policy {
  id          String         @id @default(cuid())
  projectId   String
  name        String
  description String?
  enabled     Boolean        @default(true)
  action      String
  decision    PolicyDecision
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvalRequests ApprovalRequest[]

  @@index([projectId])
  @@index([projectId, action])
  @@index([projectId, enabled])
  @@map("policies")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model ApprovalRequest {
  id                String         @id @default(cuid())
  projectId         String
  policyId          String?
  requestedByUserId String
  agentId           String?
  action            String
  idempotencyKey    String?
  status            ApprovalStatus @default(PENDING)
  reason            String?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  resolvedAt        DateTime?
  resolvedByUserId  String?

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  policy          Policy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  requestedByUser User    @relation("ApprovalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  resolvedByUser  User?   @relation("ApprovalResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  agent           Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([projectId, idempotencyKey])
  @@index([projectId])
  @@index([projectId, status])
  @@index([requestedByUserId])
  @@index([agentId])
  @@index([createdAt])
  @@map("approval_requests")
}

enum PaymentStatus {
  REQUIRED
  SUBMITTED
  VERIFIED
  SETTLED
  FAILED
}

model Payment {
  id                   String        @id @default(cuid())
  projectId            String
  requesterUserId      String
  agentId              String?
  action               String
  amount               String
  asset                String
  network              String
  payerAddress         String?
  receiverAddress      String
  status               PaymentStatus @default(REQUIRED)
  x402PaymentReference String?       @unique
  transactionReference String?
  executionId          String?
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  settledAt            DateTime?

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requesterUser User    @relation("PaymentRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  agent         Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([requesterUserId])
  @@index([agentId])
  @@index([status])
  @@map("payments")
}

/// Short-lived credential that lets one BYOA agent process open a WebSocket for
/// exactly one agent in one project. Deliberately not a session: it cannot be
/// used against the REST API, it carries no user login, and it expires. Only
/// the project member who owns the agent can mint one. Stored as a SHA-256
/// hash so a database read cannot be replayed against the socket.
model AgentConnectToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  agentId        String
  projectId      String
  issuedByUserId String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  agent    Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issuedBy User    @relation("AgentConnectTokenIssuer", fields: [issuedByUserId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([projectId])
  @@index([expiresAt])
  @@map("agent_connect_tokens")
}

enum TerminalVisibility {
  PRIVATE
  SHARED
}

enum TerminalSessionStatus {
  ACTIVE
  DISCONNECTED
  CLOSED
}

/// A developer's local terminal connected to the workspace. Metadata only:
/// output is never persisted. It lives in a bounded in-memory buffer on the
/// server and is forwarded only to viewers the visibility allows.
model TerminalSession {
  id           String                @id @default(cuid())
  projectId    String
  ownerUserId  String
  agentId      String?
  name         String
  command      String?
  cwd          String?
  visibility   TerminalVisibility    @default(PRIVATE)
  status       TerminalSessionStatus @default(ACTIVE)
  cols         Int?
  rows         Int?
  lastActiveAt DateTime              @default(now())
  closedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User    @relation("TerminalSessionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([ownerUserId])
  @@index([agentId])
  @@map("terminal_sessions")
}
